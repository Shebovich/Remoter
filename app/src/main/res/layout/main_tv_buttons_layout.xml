<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:padding="16dp"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <ImageButton
        android:id="@+id/powerButton"
        app:layout_constraintEnd_toStartOf="@id/browserButton"
        app:layout_constraintStart_toStartOf="parent"
        android:src="@drawable/power_svgrepo_com"
        app:tint="#FF0505"
        android:padding="10dp"
        android:background="@drawable/rounded_background"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

    <ImageButton
        android:id="@+id/browserButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:background="@drawable/rounded_background"
        android:padding="10dp"
        android:src="@drawable/browser_svgrepo_com"
        app:layout_constraintEnd_toStartOf="@id/searchButton"
        app:layout_constraintStart_toEndOf="@id/powerButton"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/white" />

    <ImageButton
        android:id="@+id/searchButton"
        app:layout_constraintStart_toEndOf="@id/browserButton"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toStartOf="@id/sourceButton"
        android:layout_width="wrap_content"
        android:background="@drawable/rounded_background"
        android:padding="10dp"
        app:tint="@color/white"
        android:src="@drawable/search_alt_svgrepo_com"
        android:layout_marginStart="16dp"
        android:layout_height="wrap_content" />

    <ImageButton
        android:id="@+id/sourceButton"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/searchButton"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_width="wrap_content"
        android:layout_marginStart="16dp"
        android:background="@drawable/rounded_background"
        android:padding="10dp"
        app:tint="@color/white"
        android:src="@drawable/exit_svgrepo_com"
        android:layout_height="wrap_content" />

</androidx.constraintlayout.widget.ConstraintLayout>